RUNGST_API_KEY=your_api_key
RUNGST_WALLET_FILE=/path/to/solana-keypair.json
# Optional: defaults to https://api.mainnet.solana.com
# RUNGST_SOLANA_RPC_URL=https://your-solana-rpc-url
# Required for --buy; amount of USDC to spend
BUY_AMOUNT_USDC=10
# Optional strategy and trade settings
# WINDOW_SECS=30
# MIN_BUYERS=5
# MIN_BUY_RATIO=0.6
# MIN_NETFLOW_USD=100
# MIN_CALLOUTS=1
# SLIPPAGE_BPS=100
# SELL_TIMEOUT_SECS=90
# MAX_BUYS_PER_MINT=1
# BUY_HISTORY_FILE=momentum-buy-history.json
# MAX_BUYS_PER_RUN=10
